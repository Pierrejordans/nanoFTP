<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NanoFTP.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="AppFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>

      <Color x:Key="SystemAccentColor">#0F9D7A</Color>
      <Color x:Key="SystemAccentColorLight1">#2BB48F</Color>
      <Color x:Key="SystemAccentColorLight2">#58C7AA</Color>
      <Color x:Key="SystemAccentColorLight3">#8ADCC7</Color>
      <Color x:Key="SystemAccentColorDark1">#0B8265</Color>
      <Color x:Key="SystemAccentColorDark2">#086850</Color>
      <Color x:Key="SystemAccentColorDark3">#054C3B</Color>

      <SolidColorBrush x:Key="CanvasBrush" Color="#F2F5F6" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F7F9FA" />
      <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#EEF3F4" />
      <SolidColorBrush x:Key="InkBrush" Color="#14212B" />
      <SolidColorBrush x:Key="InkSecondaryBrush" Color="#485964" />
      <SolidColorBrush x:Key="MutedBrush" Color="#788993" />
      <SolidColorBrush x:Key="FaintBrush" Color="#9AA8B0" />
      <SolidColorBrush x:Key="BorderBrush" Color="#E2E8EB" />
      <SolidColorBrush x:Key="BorderStrongBrush" Color="#CFDAE0" />
      <SolidColorBrush x:Key="AccentBrush" Color="#0F9D7A" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#0B8768" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#087256" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F7F2" />
      <SolidColorBrush x:Key="AccentSoftHoverBrush" Color="#DDF2EA" />
      <SolidColorBrush x:Key="BlueBrush" Color="#3F7EDB" />
      <SolidColorBrush x:Key="BlueSoftBrush" Color="#EDF3FD" />
      <SolidColorBrush x:Key="DangerBrush" Color="#D95B51" />
      <SolidColorBrush x:Key="DangerSoftBrush" Color="#FCEEED" />
      <SolidColorBrush x:Key="WarningBrush" Color="#C78A20" />
      <SolidColorBrush x:Key="WarningSoftBrush" Color="#FBF4E4" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#148564" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#111B23" />
      <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#192630" />
      <SolidColorBrush x:Key="SidebarHoverBrush" Color="#1E2D39" />
      <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#223441" />
      <SolidColorBrush x:Key="SidebarBorderBrush" Color="#263743" />
      <SolidColorBrush x:Key="SidebarTextBrush" Color="#F1F6F7" />
      <SolidColorBrush x:Key="SidebarMutedBrush" Color="#8A9CA7" />
      <SolidColorBrush x:Key="SidebarFaintBrush" Color="#647783" />

      <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Offset="0" Color="#14212A" />
        <GradientStop Offset="1" Color="#0C151C" />
      </LinearGradientBrush>

      <StreamGeometry x:Key="IconPlus">M10.75 4.5h2.5v6.25H19.5v2.5h-6.25v6.25h-2.5v-6.25H4.5v-2.5h6.25z</StreamGeometry>
      <StreamGeometry x:Key="IconEdit">M4 17.25V20h2.75L17.8 8.95l-2.75-2.75L4 17.25zM20.7 6.04a1 1 0 0 0 0-1.41l-1.33-1.33a1 1 0 0 0-1.41 0l-1.1 1.1 2.75 2.75 1.09-1.11z</StreamGeometry>
      <StreamGeometry x:Key="IconRefresh">M17.65 6.35A7.95 7.95 0 0 0 12 4a8 8 0 1 0 7.9 9.25h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</StreamGeometry>
      <StreamGeometry x:Key="IconArrowUp">M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z</StreamGeometry>
      <StreamGeometry x:Key="IconArrowDown">M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z</StreamGeometry>
      <StreamGeometry x:Key="IconChevronUp">M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z</StreamGeometry>
      <StreamGeometry x:Key="IconChevronRight">M9 6l6 6-6 6-1.4-1.4 4.6-4.6-4.6-4.6z</StreamGeometry>
      <StreamGeometry x:Key="IconFolder">M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z</StreamGeometry>
      <StreamGeometry x:Key="IconFile">M6 2c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6H6zm7 1.5L18.5 9H13V3.5z</StreamGeometry>
      <StreamGeometry x:Key="IconMonitor">M20 3H4c-1.1 0-2 .9-2 2v11c0 1.1.9 2 2 2h6l-1 2H7v2h10v-2h-2l-1-2h6c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 13H4V5h16v11z</StreamGeometry>
      <StreamGeometry x:Key="IconCloud">M19.35 10.04A7.49 7.49 0 0 0 12 4a7.48 7.48 0 0 0-6.65 4.04A5.99 5.99 0 0 0 6 20h13a5 5 0 0 0 .35-9.96z</StreamGeometry>
      <StreamGeometry x:Key="IconClose">M18.3 5.71L12 12l6.3 6.29-1.41 1.42L10.59 13.4 4.3 19.71 2.89 18.3 9.17 12 2.89 5.71 4.3 4.29l6.29 6.3 6.3-6.3z</StreamGeometry>
      <StreamGeometry x:Key="IconCheck">M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</StreamGeometry>
      <StreamGeometry x:Key="IconWarning">M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z</StreamGeometry>
      <StreamGeometry x:Key="IconHome">M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z</StreamGeometry>
      <StreamGeometry x:Key="IconTrash">M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</StreamGeometry>
      <StreamGeometry x:Key="IconEye">M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z</StreamGeometry>
      <StreamGeometry x:Key="IconQueue">M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z</StreamGeometry>
      <StreamGeometry x:Key="IconSwap">M6.99 11L3 15l3.99 4v-3H14v-2H6.99v-3zM21 9l-3.99-4v3H10v2h7.01v3L21 9z</StreamGeometry>
      <StreamGeometry x:Key="IconPower">M13 3h-2v10h2V3zm4.83 2.17l-1.42 1.42A6.92 6.92 0 0 1 19 12c0 3.87-3.13 7-7 7s-7-3.13-7-7c0-2.27 1.08-4.28 2.75-5.55L6.34 5.03A8.94 8.94 0 0 0 3 12c0 4.97 4.03 9 9 9s9-4.03 9-9c0-2.75-1.24-5.21-3.17-6.83z</StreamGeometry>
      <StreamGeometry x:Key="IconServer">M4 3h16c.55 0 1 .45 1 1v6c0 .55-.45 1-1 1H4c-.55 0-1-.45-1-1V4c0-.55.45-1 1-1zm2 3c0 .55.45 1 1 1s1-.45 1-1-.45-1-1-1-1 .45-1 1zM4 13h16c.55 0 1 .45 1 1v6c0 .55-.45 1-1 1H4c-.55 0-1-.45-1-1v-6c0-.55.45-1 1-1zm2 3c0 .55.45 1 1 1s1-.45 1-1-.45-1-1-1-1 .45-1 1z</StreamGeometry>
      <StreamGeometry x:Key="IconLink">M3.9 12a3.1 3.1 0 0 1 3.1-3.1h4V7H7a5 5 0 0 0 0 10h4v-1.9H7A3.1 3.1 0 0 1 3.9 12zM8 13h8v-2H8v2zm9-6h-4v1.9h4a3.1 3.1 0 0 1 0 6.2h-4V17h4a5 5 0 0 0 0-10z</StreamGeometry>
      <StreamGeometry x:Key="IconUploadTray">M5 20h14v-2H5v2zM12 2L6.5 7.5l1.4 1.4L11 5.8V16h2V5.8l3.1 3.1 1.4-1.4L12 2z</StreamGeometry>
      <StreamGeometry x:Key="IconDownloadTray">M19 18H5v2h14v-2zM12 22l5.5-5.5-1.4-1.4-3.1 3.1V6h-2v12.2l-3.1-3.1-1.4 1.4L12 22z</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <Style Selector="TextBlock.subtitle">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style Selector="TextBlock.pane-title">
      <Setter Property="FontSize" Value="14.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <Style Selector="TextBlock.pane-subtitle">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style Selector="TextBlock.faint">
      <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
      <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="TextBlock.section-label">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
      <Setter Property="LetterSpacing" Value="1.3" />
    </Style>

    <Style Selector="TextBlock.sidebar-section-label">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource SidebarMutedBrush}" />
      <Setter Property="LetterSpacing" Value="1.3" />
    </Style>

    <Style Selector="TextBlock.sidebar-title">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
    </Style>

    <Style Selector="TextBlock.sidebar-muted">
      <Setter Property="Foreground" Value="{StaticResource SidebarMutedBrush}" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style Selector="TextBlock.file-name">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.col-header">
      <Setter Property="FontSize" Value="9.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
      <Setter Property="LetterSpacing" Value="0.8" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.stat">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style Selector="TextBlock.error-text">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>

    <Style Selector="TextBlock.transfer-status">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.transfer-status.failed">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>

    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <Style Selector="TextBlock.helper">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Button">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#A8CFC4" />
      <Setter Property="Foreground" Value="#F7FFFC" />
    </Style>
    <Style Selector="Button.secondary:disabled">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Button.primary:disabled">
      <Setter Property="Opacity" Value="0.75" />
    </Style>

    <Style Selector="Button.secondary">
      <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.secondary /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="Button.secondary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <Style Selector="Button.icon">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="Button.icon /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>
    <Style Selector="Button.icon:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>

    <Style Selector="Button.icon-on-dark">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="#24343F" />
      <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon-on-dark /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#24343F" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
    </Style>
    <Style Selector="Button.icon-on-dark:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2C4351" />
    </Style>

    <Style Selector="Button.bridge">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="19" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.bridge /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="19" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="Button.bridge:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="#BFE4D9" />
      <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.bridge:disabled">
      <Setter Property="Opacity" Value="0.32" />
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
    </Style>

    <Style Selector="Button.tiny">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="TextBox.field">
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Padding" Value="11,7" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.field.invalid">
      <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
      <Setter Property="Background" Value="#FFF9F8" />
    </Style>
    <Style Selector="TextBox.field:focus">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox.path">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="3,4" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource InkSecondaryBrush}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.path /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BoxShadow" Value="0 1 2 0 #080C1A20, 0 9 28 0 #080C1A20" />
    </Style>

    <Style Selector="Border.icon-tile">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
    </Style>

    <Style Selector="Border.path-bar">
      <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="3" />
    </Style>

    <Style Selector="Border.soft-pill">
      <Setter Property="Background" Value="{StaticResource SurfaceSoftBrush}" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <Style Selector="ListBoxItem.file-row">
      <Setter Property="Margin" Value="6,1" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="ListBoxItem.file-row /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBoxItem.file-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F5F8F9" />
    </Style>
    <Style Selector="ListBoxItem.file-row:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    </Style>
    <Style Selector="ListBoxItem.file-row:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentSoftHoverBrush}" />
    </Style>

    <Style Selector="ListBoxItem.connection-row">
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ListBoxItem.connection-row /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBoxItem.connection-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SidebarHoverBrush}" />
    </Style>
    <Style Selector="ListBoxItem.connection-row:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}" />
    </Style>

    <Style Selector="Button.connection-edit">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource SidebarMutedBrush}" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.connection-edit /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{StaticResource SidebarMutedBrush}" />
    </Style>
    <Style Selector="ListBoxItem.connection-row:pointerover Button.connection-edit">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="ListBoxItem.connection-row:selected Button.connection-edit">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Button.connection-edit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2D4150" />
      <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
    </Style>

    <Style Selector="ComboBox.compact">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Width" Value="62" />
      <Setter Property="Padding" Value="9,2" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="MinHeight" Value="3" />
      <Setter Property="Height" Value="3" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Background" Value="#E7EEEF" />
    </Style>

    <Style Selector="ProgressBar.queue">
      <Setter Property="MinHeight" Value="2" />
      <Setter Property="Height" Value="2" />
      <Setter Property="CornerRadius" Value="1" />
    </Style>

    <Style Selector="ToolTip">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="ScrollViewer">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Border.transfer-row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#F0F3F5" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="14,8" />
    </Style>

    <Style Selector="Border.transfer-row:pointerover">
      <Setter Property="Background" Value="#FAFCFC" />
    </Style>

    <Style Selector="Border.direction-badge">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.direction-badge.upload">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    </Style>
    <Style Selector="Border.direction-badge.download">
      <Setter Property="Background" Value="{StaticResource BlueSoftBrush}" />
    </Style>

    <Style Selector="Border.notice">
      <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.notice.error">
      <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
      <Setter Property="BorderBrush" Value="#F3D2CF" />
    </Style>
    <Style Selector="Border.notice.warning">
      <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
      <Setter Property="BorderBrush" Value="#EFE0BE" />
    </Style>
    <Style Selector="Border.notice.success">
      <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
      <Setter Property="BorderBrush" Value="#CBEADF" />
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="ToggleSwitch">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
      <Setter Property="FontSize" Value="12.5" />
    </Style>
  </Application.Styles>
</Application>
