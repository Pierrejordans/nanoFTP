<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NanoFTP.ViewModels"
        xmlns:models="using:NanoFTP.Models"
        x:Class="NanoFTP.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="NanoFTP — Client FTP"
        Width="1320"
        Height="820"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        UseLayoutRounding="True">

  <Grid ColumnDefinitions="286,*">

    <!-- Barre latérale -->
    <Border Grid.Column="0" Background="{StaticResource SidebarGradientBrush}">
      <Grid Margin="18,20,18,16" RowDefinitions="Auto,Auto,*,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
          <Border Width="42" Height="42" CornerRadius="12" ClipToBounds="True">
            <Image Source="avares://NanoFTP/Assets/nanoftp.png" Stretch="Uniform" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="NanoFTP" FontSize="17" FontWeight="Bold" Foreground="{StaticResource SidebarTextBrush}" />
            <TextBlock Text="FTP simple et direct" Classes="sidebar-muted" FontSize="10.5" />
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,28,0,0" ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="CONNEXIONS" Classes="sidebar-section-label" VerticalAlignment="Center" />
            <Border Background="#1D2B35" CornerRadius="10" Padding="7,2" VerticalAlignment="Center">
              <TextBlock Text="{Binding ConnectionCountText}" FontSize="9" Foreground="{StaticResource SidebarMutedBrush}" />
            </Border>
          </StackPanel>
          <Button Grid.Column="1"
                  Classes="icon-on-dark"
                  Click="AddConnection_Click"
                  ToolTip.Tip="Ajouter une connexion (Ctrl+N)"
                  AutomationProperties.Name="Ajouter une connexion">
            <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14" />
          </Button>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
          <ListBox x:Name="ConnectionsList"
                   ItemsSource="{Binding Connections}"
                   SelectedItem="{Binding SelectedConnection, Mode=OneWay}"
                   SelectionChanged="ConnectionsList_SelectionChanged"
                   DoubleTapped="ConnectionsList_DoubleTapped"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusAdorner" Value="{x:Null}" />
              </Style>
              <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="0" />
              </Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{StaticResource SidebarHoverBrush}" />
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}" />
              </Style>
              <Style Selector="ListBoxItem:pointerover Button.connection-edit">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="IsHitTestVisible" Value="True" />
              </Style>
              <Style Selector="ListBoxItem:selected Button.connection-edit">
                <Setter Property="Opacity" Value="1" />
                <Setter Property="IsHitTestVisible" Value="True" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ConnectionItemViewModel">
                <Border Background="Transparent" CornerRadius="10" Padding="10,10">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Grid Width="32" Height="32" VerticalAlignment="Center">
                      <Border Width="30" Height="30" CornerRadius="8" Background="#233440" />
                      <PathIcon Data="{StaticResource IconServer}"
                                Width="15" Height="15"
                                Foreground="{StaticResource SidebarMutedBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                      <Ellipse Width="9" Height="9"
                               Fill="{Binding StatusBrush}"
                               Stroke="#18252F"
                               StrokeThickness="2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,0" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center" Spacing="2">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="12.5"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource SidebarTextBrush}"
                                 TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding HostLine}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource SidebarMutedBrush}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="·" FontSize="10.5" Foreground="{StaticResource SidebarFaintBrush}" />
                        <TextBlock Text="{Binding StatusLabel}"
                                   FontSize="10.5"
                                   FontWeight="Medium"
                                   Foreground="{Binding StatusBrush}" />
                      </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="connection-edit"
                            Click="EditConnection_Click"
                            ToolTip.Tip="Modifier cette connexion"
                            AutomationProperties.Name="{Binding Name, StringFormat='Modifier {0}'}">
                      <PathIcon Data="{StaticResource IconEdit}" Width="13" Height="13" />
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel IsVisible="{Binding ShowNoConnections}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="12"
                      MaxWidth="200">
            <Border Width="46" Height="46" CornerRadius="23" Background="#192630" HorizontalAlignment="Center">
              <PathIcon Data="{StaticResource IconCloud}" Width="22" Height="22" Foreground="{StaticResource SidebarMutedBrush}" />
            </Border>
            <StackPanel Spacing="4">
              <TextBlock Text="Aucune connexion"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource SidebarTextBrush}"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Ajoutez votre premier serveur FTP pour commencer."
                         Classes="sidebar-muted"
                         TextWrapping="Wrap"
                         TextAlignment="Center" />
            </StackPanel>
            <Button Classes="primary"
                    Content="Ajouter une connexion"
                    Click="AddConnection_Click"
                    HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Spacing="10">
          <Border Background="#16232D"
                  BorderBrush="{StaticResource SidebarBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="12">
            <StackPanel Spacing="5">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <PathIcon Data="{StaticResource IconSwap}" Width="12" Height="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="Glisser-déposer" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SidebarTextBrush}" />
              </StackPanel>
              <TextBlock Text="Entre l'ordinateur et le serveur, dans les deux sens."
                         Classes="sidebar-muted"
                         FontSize="10.5"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="FTP · FTPS explicite" FontSize="9.5" Foreground="{StaticResource SidebarFaintBrush}" />
            <TextBlock Grid.Column="1" Text="v1.0" FontSize="9.5" Foreground="{StaticResource SidebarFaintBrush}" />
          </Grid>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Espace de travail -->
    <Grid Grid.Column="1" Margin="22,18,22,18" RowDefinitions="Auto,*,Auto">

      <StackPanel Grid.Row="0" Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3">
            <TextBlock Text="Espace de travail" Classes="title" />
            <TextBlock Text="{Binding WorkspaceCaption}" Classes="subtitle" />
          </StackPanel>
          <Button Grid.Column="1"
                  Classes="secondary"
                  Click="RefreshAll_Click"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Actualiser les deux volets (F5)"
                  AutomationProperties.Name="Actualiser les deux volets">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource IconRefresh}" Width="13" Height="13" Foreground="{StaticResource InkSecondaryBrush}" />
              <TextBlock Text="Actualiser" FontSize="12" Foreground="{StaticResource InkSecondaryBrush}" />
            </StackPanel>
          </Button>
        </Grid>

        <Border Classes="notice error" IsVisible="{Binding HasGlobalError}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <PathIcon Data="{StaticResource IconWarning}" Width="15" Height="15"
                      Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Margin="9,0,12,0"
                       Text="{Binding GlobalError}"
                       FontSize="11.5"
                       Foreground="#8C3D37"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="icon" Click="DismissError_Click"
                    ToolTip.Tip="Fermer" AutomationProperties.Name="Fermer le message">
              <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
            </Button>
          </Grid>
        </Border>

        <Border Classes="notice warning" IsVisible="{Binding HasGlobalWarning}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <PathIcon Data="{StaticResource IconWarning}" Width="15" Height="15"
                      Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Margin="9,0,12,0"
                       Text="{Binding GlobalWarning}"
                       FontSize="11.5"
                       Foreground="#7A5A17"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="icon" Click="DismissWarning_Click"
                    ToolTip.Tip="Fermer" AutomationProperties.Name="Fermer l'avertissement">
              <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
            </Button>
          </Grid>
        </Border>
      </StackPanel>

      <!-- Deux explorateurs -->
      <Grid Grid.Row="1" Margin="0,14,0,0" ColumnDefinitions="*,58,*">

        <!-- Ordinateur -->
        <Border x:Name="LocalCard"
                Grid.Column="0"
                Classes="card"
                DragDrop.AllowDrop="True">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" Height="70" Margin="16,0" ColumnDefinitions="Auto,*,Auto">
              <Border Classes="icon-tile" Width="36" Height="36" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconMonitor}" Width="18" Height="18"
                          Foreground="{StaticResource InkSecondaryBrush}" />
              </Border>
              <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding Local.Title}" Classes="pane-title" />
                <TextBlock Text="{Binding Local.Subtitle}" Classes="pane-subtitle" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
                <Button Classes="icon" Click="LocalHome_Click" ToolTip.Tip="Dossier personnel" AutomationProperties.Name="Dossier personnel">
                  <PathIcon Data="{StaticResource IconHome}" Width="14" Height="14" />
                </Button>
                <Button Classes="icon" Click="LocalRefresh_Click" ToolTip.Tip="Actualiser" AutomationProperties.Name="Actualiser le dossier local">
                  <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" />
                </Button>
              </StackPanel>
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*,Auto">
              <Border Grid.Row="0" Classes="path-bar" Margin="12,0,12,10" Height="36">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Button Classes="icon" Width="28" Height="28" Click="LocalUp_Click"
                          ToolTip.Tip="Dossier parent" AutomationProperties.Name="Remonter d'un dossier">
                    <PathIcon Data="{StaticResource IconChevronUp}" Width="14" Height="14" />
                  </Button>
                  <TextBox x:Name="LocalPathBox"
                           Grid.Column="1"
                           Classes="path"
                           Text="{Binding Local.PathInput, Mode=TwoWay}"
                           KeyDown="LocalPath_KeyDown"
                           VerticalAlignment="Center"
                           ToolTip.Tip="Entrée pour ouvrir ce chemin"
                           AutomationProperties.Name="Chemin local" />
                  <Button Grid.Column="2" Classes="icon" Width="28" Height="28" Click="LocalGo_Click"
                          ToolTip.Tip="Ouvrir ce chemin" AutomationProperties.Name="Ouvrir le chemin local">
                    <PathIcon Data="{StaticResource IconChevronRight}" Width="14" Height="14" />
                  </Button>
                </Grid>
              </Border>

              <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding Local.IsLoading}" />

              <Grid Grid.Row="2" Margin="12,0,12,8">
                <Border IsVisible="{Binding Local.IsRenaming}"
                        Background="{StaticResource SurfaceMutedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,6">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="Renommer" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource InkSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="LocalRenameBox"
                             Grid.Column="1"
                             Classes="path"
                             Text="{Binding Local.RenameText, Mode=TwoWay}"
                             KeyDown="LocalRename_KeyDown"
                             AutomationProperties.Name="Nouveau nom" />
                    <Button Grid.Column="2" Classes="tiny secondary" Content="Annuler"
                            Click="LocalRenameCancel_Click" />
                    <Button Grid.Column="3" Classes="tiny primary" Content="Renommer"
                            Click="LocalRenameConfirm_Click" />
                  </Grid>
                </Border>

                <Border IsVisible="{Binding Local.IsConfirmingDelete}"
                        Background="{StaticResource DangerSoftBrush}"
                        BorderBrush="#F1C9C5"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,6">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <PathIcon Data="{StaticResource IconWarning}" Width="14" Height="14"
                              Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Local.DeletePrompt}"
                               FontSize="11"
                               Foreground="#8C3D37"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="tiny secondary" Content="Annuler"
                            Click="LocalDeleteCancel_Click" />
                    <Button Grid.Column="3" Classes="tiny secondary" Content="Supprimer"
                            Foreground="{StaticResource DangerBrush}"
                            Click="LocalDeleteConfirm_Click" />
                  </Grid>
                </Border>
              </Grid>

              <Grid Grid.Row="3" RowDefinitions="Auto,*">
                <Grid Grid.Row="0" Height="26" Margin="18,0,18,3" ColumnDefinitions="*,78,110">
                  <TextBlock Text="NOM" Classes="col-header" />
                  <TextBlock Grid.Column="1" Text="TAILLE" Classes="col-header" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="2" Text="MODIFIÉ" Classes="col-header" HorizontalAlignment="Right" />
                </Grid>

                <Grid Grid.Row="1">
                  <ListBox x:Name="LocalList"
                           ItemsSource="{Binding Local.Entries}"
                           SelectionMode="Multiple"
                           SelectionChanged="LocalList_SelectionChanged"
                           DoubleTapped="LocalList_DoubleTapped"
                           ContextRequested="LocalList_ContextRequested"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Sélectionner" Click="LocalContextSelect_Click" />
                        <MenuItem Header="Renommer" Click="LocalContextRename_Click" />
                        <Separator />
                        <MenuItem Header="Ouvrir dans l'explorateur de fichiers"
                                  Click="LocalContextReveal_Click" />
                        <Separator />
                        <MenuItem Header="Supprimer"
                                  Foreground="{StaticResource DangerBrush}"
                                  Click="LocalContextDelete_Click" />
                      </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="models:FileEntry">
                        <Grid Height="38" Margin="10,0" ColumnDefinitions="*,78,110">
                          <Grid ColumnDefinitions="28,*">
                            <Border Width="24" Height="24" CornerRadius="6"
                                    Background="{StaticResource SurfaceMutedBrush}"
                                    VerticalAlignment="Center">
                              <Grid>
                                <PathIcon Data="{StaticResource IconFolder}"
                                          IsVisible="{Binding IsDirectory}"
                                          Width="13" Height="13"
                                          Foreground="{StaticResource AccentBrush}" />
                                <PathIcon Data="{StaticResource IconFile}"
                                          IsVisible="{Binding IsFile}"
                                          Width="12" Height="13"
                                          Foreground="{StaticResource MutedBrush}" />
                              </Grid>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="file-name"
                                       Margin="2,0,8,0" ToolTip.Tip="{Binding FullPath}" />
                          </Grid>
                          <TextBlock Grid.Column="1" Text="{Binding SizeText}" Classes="stat"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" Classes="stat"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <StackPanel IsVisible="{Binding Local.ShowEmptyPlaceholder}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Spacing="10"
                              Margin="24">
                    <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource SurfaceMutedBrush}" HorizontalAlignment="Center">
                      <PathIcon Data="{StaticResource IconFolder}" Width="20" Height="20" Foreground="{StaticResource FaintBrush}" />
                    </Border>
                    <StackPanel Spacing="3">
                      <TextBlock Text="Dossier vide" FontSize="12.5" FontWeight="SemiBold"
                                 Foreground="{StaticResource InkSecondaryBrush}" HorizontalAlignment="Center" />
                      <TextBlock Text="Aucun fichier à afficher ici." FontSize="11"
                                 Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>

                  <StackPanel IsVisible="{Binding Local.ShowFullError}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Spacing="10"
                              MaxWidth="320"
                              Margin="24">
                    <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource DangerSoftBrush}" HorizontalAlignment="Center">
                      <PathIcon Data="{StaticResource IconWarning}" Width="20" Height="20" Foreground="{StaticResource DangerBrush}" />
                    </Border>
                    <TextBlock Text="{Binding Local.ErrorMessage}" FontSize="11.5"
                               Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                    <Button Classes="secondary" Content="Réessayer" Click="LocalRefresh_Click" HorizontalAlignment="Center" />
                  </StackPanel>

                  <Border Classes="notice error"
                          IsVisible="{Binding Local.ShowErrorBanner}"
                          Margin="12,4,12,0"
                          VerticalAlignment="Top"
                          ZIndex="4">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <PathIcon Data="{StaticResource IconWarning}" Width="14" Height="14"
                                Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Margin="8,0,8,0" Text="{Binding Local.ErrorMessage}"
                                 FontSize="11" Foreground="#8C3D37" TextWrapping="Wrap" />
                      <Button Grid.Column="2" Classes="tiny secondary" Content="Réessayer" Click="LocalRefresh_Click" />
                    </Grid>
                  </Border>

                  <Border x:Name="LocalDropOverlay"
                          IsVisible="False"
                          IsHitTestVisible="False"
                          Background="#E8F7F2"
                          BorderBrush="{StaticResource AccentBrush}"
                          BorderThickness="2"
                          CornerRadius="0"
                          ZIndex="10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                      <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource AccentBrush}" HorizontalAlignment="Center">
                        <PathIcon Data="{StaticResource IconArrowDown}" Width="20" Height="20" Foreground="White" />
                      </Border>
                      <TextBlock Text="Relâchez pour télécharger" FontSize="13" FontWeight="SemiBold"
                                 Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>

              <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Height="34" Padding="16,0">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Local.EntryCountText}" Classes="stat" />
                    <TextBlock Text="·" Classes="stat" IsVisible="{Binding Local.HasSelection}" />
                    <TextBlock Text="{Binding Local.SelectionText}" FontSize="10.5"
                               Foreground="{StaticResource AccentHoverBrush}"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="Double-clic : ouvrir / transférer" Classes="faint" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Border>

        <!-- Passerelle -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10" HorizontalAlignment="Center">
          <Button x:Name="UploadButton"
                  Classes="bridge"
                  Click="UploadSelection_Click"
                  IsEnabled="False"
                  ToolTip.Tip="Envoyer les fichiers et dossiers sélectionnés"
                  AutomationProperties.Name="Envoyer les fichiers et dossiers sélectionnés">
            <PathIcon Data="{StaticResource IconArrowUp}" Width="17" Height="17" />
          </Button>
          <Border Width="1" Height="22" Background="{StaticResource BorderBrush}" HorizontalAlignment="Center" />
          <Button x:Name="DownloadButton"
                  Classes="bridge"
                  Click="DownloadSelection_Click"
                  IsEnabled="False"
                  ToolTip.Tip="Télécharger les fichiers et dossiers sélectionnés"
                  AutomationProperties.Name="Télécharger les fichiers et dossiers sélectionnés">
            <PathIcon Data="{StaticResource IconArrowDown}" Width="17" Height="17" />
          </Button>
        </StackPanel>

        <!-- Serveur -->
        <Border x:Name="RemoteCard"
                Grid.Column="2"
                Classes="card"
                DragDrop.AllowDrop="True">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" Height="70" Margin="16,0" ColumnDefinitions="Auto,*,Auto">
              <Border Classes="icon-tile" Width="36" Height="36" VerticalAlignment="Center">
                <PathIcon Data="{StaticResource IconCloud}" Width="18" Height="18"
                          Foreground="{StaticResource InkSecondaryBrush}" />
              </Border>
              <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding Remote.Title}" Classes="pane-title" />
                <TextBlock Text="{Binding Remote.Subtitle}" Classes="pane-subtitle" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                            IsVisible="{Binding Remote.HasProfile}">
                  <Ellipse Width="7" Height="7" Fill="{Binding Remote.StatusBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Remote.StatusLabel}" FontSize="10.5"
                             Foreground="{Binding Remote.StatusBrush}"
                             FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>
                <Button Classes="primary"
                        Content="{Binding Remote.ConnectButtonLabel}"
                        Click="Connect_Click"
                        IsVisible="{Binding Remote.CanConnect}"
                        MinHeight="30"
                        Padding="12,6"
                        FontSize="11.5" />
                <Button Classes="secondary"
                        Content="Connexion…"
                        IsVisible="{Binding Remote.ShowDisconnectingButton}"
                        IsEnabled="False"
                        MinHeight="30"
                        Padding="12,6"
                        FontSize="11.5" />
                <Button Classes="icon" Click="Disconnect_Click"
                        IsVisible="{Binding Remote.CanDisconnect}"
                        ToolTip.Tip="Se déconnecter"
                        AutomationProperties.Name="Se déconnecter">
                  <PathIcon Data="{StaticResource IconPower}" Width="15" Height="15" />
                </Button>
              </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
              <Grid IsVisible="{Binding Remote.ShowConnectedContent}" RowDefinitions="Auto,Auto,*,Auto">
                <Border Grid.Row="0" Classes="path-bar" Margin="12,0,12,10" Height="36">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Classes="icon" Width="28" Height="28" Click="RemoteUp_Click"
                            ToolTip.Tip="Dossier parent" AutomationProperties.Name="Remonter d'un dossier distant">
                      <PathIcon Data="{StaticResource IconChevronUp}" Width="14" Height="14" />
                    </Button>
                    <TextBox x:Name="RemotePathBox"
                             Grid.Column="1"
                             Classes="path"
                             Text="{Binding Remote.PathInput, Mode=TwoWay}"
                             KeyDown="RemotePath_KeyDown"
                             VerticalAlignment="Center"
                             ToolTip.Tip="Entrée pour ouvrir ce chemin"
                             AutomationProperties.Name="Chemin distant" />
                    <Button Grid.Column="2" Classes="icon" Width="28" Height="28" Click="RemoteGo_Click"
                            ToolTip.Tip="Ouvrir ce chemin" AutomationProperties.Name="Ouvrir le chemin distant">
                      <PathIcon Data="{StaticResource IconChevronRight}" Width="14" Height="14" />
                    </Button>
                  </Grid>
                </Border>

                <ProgressBar Grid.Row="1" IsIndeterminate="True" IsVisible="{Binding Remote.IsLoading}" />

                <Grid Grid.Row="2" RowDefinitions="Auto,*">
                  <Grid Grid.Row="0" Height="26" Margin="18,0,18,3" ColumnDefinitions="*,78,110">
                    <TextBlock Text="NOM" Classes="col-header" />
                    <TextBlock Grid.Column="1" Text="TAILLE" Classes="col-header" HorizontalAlignment="Right" />
                    <TextBlock Grid.Column="2" Text="MODIFIÉ" Classes="col-header" HorizontalAlignment="Right" />
                  </Grid>

                  <Grid Grid.Row="1">
                    <ListBox x:Name="RemoteList"
                             ItemsSource="{Binding Remote.Entries}"
                             SelectionMode="Multiple"
                             SelectionChanged="RemoteList_SelectionChanged"
                             DoubleTapped="RemoteList_DoubleTapped"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:FileEntry">
                          <Grid Height="38" Margin="10,0" ColumnDefinitions="*,78,110">
                            <Grid ColumnDefinitions="28,*">
                              <Border Width="24" Height="24" CornerRadius="6"
                                      Background="{StaticResource SurfaceMutedBrush}"
                                      VerticalAlignment="Center">
                                <Grid>
                                  <PathIcon Data="{StaticResource IconFolder}"
                                            IsVisible="{Binding IsDirectory}"
                                            Width="13" Height="13"
                                            Foreground="{StaticResource AccentBrush}" />
                                  <PathIcon Data="{StaticResource IconFile}"
                                            IsVisible="{Binding IsFile}"
                                            Width="12" Height="13"
                                            Foreground="{StaticResource MutedBrush}" />
                                </Grid>
                              </Border>
                              <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="file-name"
                                         Margin="2,0,8,0" ToolTip.Tip="{Binding FullPath}" />
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" Classes="stat"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" Classes="stat"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel IsVisible="{Binding Remote.ShowEmptyDirectory}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                Margin="24">
                      <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource SurfaceMutedBrush}" HorizontalAlignment="Center">
                        <PathIcon Data="{StaticResource IconFolder}" Width="20" Height="20" Foreground="{StaticResource FaintBrush}" />
                      </Border>
                      <StackPanel Spacing="3">
                        <TextBlock Text="Dossier distant vide" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Déposez un fichier ici pour l'envoyer." FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding Remote.ShowListingErrorState}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10"
                                MaxWidth="330"
                                Margin="24">
                      <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource DangerSoftBrush}" HorizontalAlignment="Center">
                        <PathIcon Data="{StaticResource IconWarning}" Width="20" Height="20" Foreground="{StaticResource DangerBrush}" />
                      </Border>
                      <TextBlock Text="{Binding Remote.ErrorMessage}" FontSize="11.5"
                                 Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                      <Button Classes="secondary" Content="Réessayer" Click="RemoteRefresh_Click" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Border Classes="notice error"
                            IsVisible="{Binding Remote.ShowListingErrorBanner}"
                            Margin="12,4,12,0"
                            VerticalAlignment="Top"
                            ZIndex="4">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <PathIcon Data="{StaticResource IconWarning}" Width="14" Height="14"
                                  Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Margin="8,0,8,0" Text="{Binding Remote.ErrorMessage}"
                                   FontSize="11" Foreground="#8C3D37" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Classes="tiny secondary" Content="Réessayer" Click="RemoteRefresh_Click" />
                      </Grid>
                    </Border>
                  </Grid>
                </Grid>

                <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Height="34" Padding="16,0">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Remote.EntryCountText}" Classes="stat" />
                      <TextBlock Text="·" Classes="stat" IsVisible="{Binding Remote.HasSelection}" />
                      <TextBlock Text="{Binding Remote.SelectionText}" FontSize="10.5"
                                 Foreground="{StaticResource AccentHoverBrush}"
                                 FontWeight="Medium"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Double-clic : ouvrir / transférer" Classes="faint" VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </Grid>

              <!-- États non connectés -->
              <StackPanel IsVisible="{Binding Remote.ShowNoProfileState}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Spacing="12"
                          MaxWidth="310"
                          Margin="26">
                <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource SurfaceMutedBrush}" HorizontalAlignment="Center">
                  <PathIcon Data="{StaticResource IconServer}" Width="24" Height="24" Foreground="{StaticResource FaintBrush}" />
                </Border>
                <StackPanel Spacing="4">
                  <TextBlock Text="Aucun serveur sélectionné" FontSize="14" FontWeight="SemiBold"
                             Foreground="{StaticResource InkSecondaryBrush}" HorizontalAlignment="Center" />
                  <TextBlock Text="Choisissez une connexion à gauche pour explorer un serveur FTP."
                             FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
                <Button Classes="secondary" Content="Gérer les connexions" Click="AddConnection_Click" HorizontalAlignment="Center" />
              </StackPanel>

              <StackPanel IsVisible="{Binding Remote.ShowDisconnectedState}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Spacing="12"
                          MaxWidth="320"
                          Margin="26">
                <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                  <PathIcon Data="{StaticResource IconCloud}" Width="24" Height="24" Foreground="{StaticResource AccentBrush}" />
                </Border>
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Remote.Title}" FontSize="14" FontWeight="SemiBold"
                             Foreground="{StaticResource InkSecondaryBrush}" HorizontalAlignment="Center" />
                  <TextBlock Text="Le serveur est prêt. Connectez-vous pour afficher son contenu."
                             FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                             TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <Button Classes="primary" Content="Se connecter" Click="Connect_Click" />
                  <Button Classes="secondary" Content="Modifier" Click="EditSelectedConnection_Click" />
                </StackPanel>
              </StackPanel>

              <StackPanel IsVisible="{Binding Remote.ShowConnectingState}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Spacing="14"
                          MaxWidth="300"
                          Margin="26">
                <ProgressBar IsIndeterminate="True" Width="150" Height="3" />
                <StackPanel Spacing="4">
                  <TextBlock Text="Connexion en cours…" FontSize="13" FontWeight="SemiBold"
                             Foreground="{StaticResource InkSecondaryBrush}" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding Remote.Subtitle}" FontSize="11.5"
                             Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>
              </StackPanel>

              <StackPanel IsVisible="{Binding Remote.ShowConnectionErrorState}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Spacing="11"
                          MaxWidth="360"
                          Margin="26">
                <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource DangerSoftBrush}" HorizontalAlignment="Center">
                  <PathIcon Data="{StaticResource IconWarning}" Width="24" Height="24" Foreground="{StaticResource DangerBrush}" />
                </Border>
                <StackPanel Spacing="4">
                  <TextBlock Text="Connexion impossible" FontSize="14" FontWeight="SemiBold"
                             Foreground="{StaticResource InkSecondaryBrush}" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding Remote.ConnectionErrorMessage}"
                             FontSize="11.5" Foreground="{StaticResource DangerBrush}"
                             TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <Button Classes="primary" Content="Réessayer" Click="Connect_Click" />
                  <Button Classes="secondary" Content="Modifier" Click="EditSelectedConnection_Click" />
                </StackPanel>
              </StackPanel>

              <Border x:Name="RemoteDropOverlay"
                      IsVisible="False"
                      IsHitTestVisible="False"
                      Background="#E8F7F2"
                      BorderBrush="{StaticResource AccentBrush}"
                      BorderThickness="2"
                      ZIndex="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                  <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource AccentBrush}" HorizontalAlignment="Center">
                    <PathIcon Data="{StaticResource IconArrowUp}" Width="20" Height="20" Foreground="White" />
                  </Border>
                  <TextBlock Text="Relâchez pour envoyer" FontSize="13" FontWeight="SemiBold"
                             Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" />
                  <TextBlock Text="Les fichiers et dossiers rejoindront la file de transfert." FontSize="10.5"
                             Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- Transferts -->
      <Border Grid.Row="2" Classes="card" Margin="0,14,0,0" Height="234">
        <Grid RowDefinitions="Auto,1,*">
          <Grid Grid.Row="0" Height="52" Margin="16,0" ColumnDefinitions="Auto,*,Auto">
            <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource IconQueue}" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="9,0,12,0" VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="Transferts" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
              <TextBlock Text="{Binding Transfers.QueueSummary}" FontSize="10.5"
                         Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="Transferts simultanés" FontSize="10.5"
                         Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
              <ComboBox x:Name="ParallelCombo"
                        Classes="compact"
                        ItemsSource="{Binding Transfers.ParallelOptions}"
                        SelectedItem="{Binding Transfers.ParallelTransfers, Mode=TwoWay}"
                        ToolTip.Tip="Nombre de transferts exécutés en parallèle"
                        AutomationProperties.Name="Nombre de transferts simultanés" />
              <Button Classes="ghost" Content="Vider" Click="ClearTransfers_Click"
                      IsVisible="{Binding Transfers.HasCompleted}"
                      FontSize="11" Padding="8,5" />
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Background="{StaticResource BorderBrush}" />

          <Grid Grid.Row="2" ColumnDefinitions="*,1,*">
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
              <Grid Height="34" Margin="16,0" ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Transfers.PendingHeader}" Classes="col-header" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Transfers.QueueSummary}" Classes="faint" VerticalAlignment="Center" />
              </Grid>
              <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding Transfers.Pending}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:TransferItem">
                        <Border Classes="transfer-row">
                          <Grid RowDefinitions="Auto,2" ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border Classes="direction-badge" Classes.upload="{Binding IsUpload}" Classes.download="{Binding IsDownload}" Grid.RowSpan="2">
                              <TextBlock Text="{Binding DirectionGlyph}" FontSize="13" FontWeight="SemiBold"
                                         Foreground="{StaticResource InkSecondaryBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,8,0" Spacing="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding FileName}" FontSize="11.5" FontWeight="Medium"
                                         Foreground="{StaticResource InkBrush}" />
                              <TextBlock Text="{Binding StatusDetail}" FontSize="10"
                                         Classes="transfer-status"
                                         Classes.failed="{Binding IsFailed}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="10"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Grid.Column="3" Classes="icon" Width="24" Height="24"
                                    Click="CancelTransfer_Click"
                                    IsVisible="{Binding CanCancel}"
                                    ToolTip.Tip="Annuler ce transfert"
                                    AutomationProperties.Name="Annuler ce transfert">
                              <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
                            </Button>
                            <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                         Classes="queue"
                                         Value="{Binding Progress}"
                                         IsVisible="{Binding IsRunning}"
                                         Margin="10,4,8,0" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <StackPanel IsVisible="{Binding Transfers.ShowPendingEmpty}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="4"
                            Margin="18">
                  <TextBlock Text="Aucun transfert en attente" FontSize="11"
                             Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                  <TextBlock Text="Glissez un fichier entre les deux volets." FontSize="10"
                             Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center" />
                </StackPanel>
              </Grid>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />

            <Grid Grid.Column="2" RowDefinitions="Auto,*">
              <Grid Height="34" Margin="16,0" ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Transfers.CompletedHeader}" Classes="col-header" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Historique" Classes="faint" VerticalAlignment="Center" />
              </Grid>
              <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding Transfers.Completed}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:TransferItem">
                        <Border Classes="transfer-row">
                          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center"
                                    Background="{StaticResource AccentSoftBrush}"
                                    IsVisible="{Binding IsCompleted}">
                              <PathIcon Data="{StaticResource IconCheck}" Width="12" Height="12"
                                        Foreground="{StaticResource SuccessBrush}" />
                            </Border>
                            <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center"
                                    Background="{StaticResource DangerSoftBrush}"
                                    IsVisible="{Binding IsFailed}">
                              <PathIcon Data="{StaticResource IconWarning}" Width="12" Height="12"
                                        Foreground="{StaticResource DangerBrush}" />
                            </Border>
                            <Border Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center"
                                    Background="{StaticResource SurfaceSoftBrush}"
                                    IsVisible="{Binding IsCancelled}">
                              <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11"
                                        Foreground="{StaticResource MutedBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,8,0" Spacing="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding FileName}" FontSize="11.5" FontWeight="Medium"
                                         Foreground="{StaticResource InkBrush}" />
                              <TextBlock Text="{Binding StatusDetail}" FontSize="10"
                                         Classes="transfer-status"
                                         Classes.failed="{Binding IsFailed}"
                                         ToolTip.Tip="{Binding Error}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="10"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button Grid.Column="3" Classes="icon" Width="24" Height="24"
                                    Click="RetryTransfer_Click"
                                    IsVisible="{Binding CanRetry}"
                                    ToolTip.Tip="Relancer ce transfert"
                                    AutomationProperties.Name="Relancer ce transfert">
                              <PathIcon Data="{StaticResource IconRefresh}" Width="12" Height="12" />
                            </Button>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <StackPanel IsVisible="{Binding Transfers.ShowCompletedEmpty}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="4"
                            Margin="18">
                  <TextBlock Text="Aucun transfert terminé" FontSize="11"
                             Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                  <TextBlock Text="Les fichiers transférés apparaîtront ici." FontSize="10"
                             Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center" />
                </StackPanel>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border x:Name="ModalScrim"
            Grid.ColumnSpan="2"
            IsVisible="False"
            IsHitTestVisible="False"
            Background="#660A131A"
            ZIndex="100" />
  </Grid>
</Window>
